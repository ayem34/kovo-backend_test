# Copier ce fichier en .env et remplir les valeurs réelles 

# Utilisés par docker-compose pour configurer le conteneur PostgreSQL
POSTGRES_USER=kovo_user
POSTGRES_PASSWORD=kovo_pass
POSTGRES_DB=kovo_db

# Utilisée par l'application en dehors de Docker (venv local classique).
# Avec docker-compose, cette valeur est automatiquement remplacée pour
# pointer vers le conteneur "db" au lieu de localhost (cf. explication
# sur le réseau Docker).
DATABASE_URL=postgresql+psycopg://kovo_user:kovo_pass@localhost:5433/kovo_db

SECRET_KEY=change-me-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
